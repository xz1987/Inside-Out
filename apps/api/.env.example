# Server-side only. Never add these values to the Xcode project or commit a filled-in copy.
# Copy to .env and fill in locally:  cp .env.example .env

# Cornell AI gateway (OpenAI-compatible). "/v1" is appended automatically.
# For direct OpenAI use https://api.openai.com/v1
LLM_HOST=https://api.ai.it.cornell.edu

# One key works for both domains. Set the per-domain keys only if you have
# separate keys (PRD §38.3); each falls back to OPENAI_API_KEY when empty.
OPENAI_API_KEY=
INPUT_DOMAIN_API_KEY=
ECOSYSTEM_DOMAIN_API_KEY=

# Model ids without the gateway prefix; "openai." is added automatically
# when LLM_HOST is not openai.com.
INPUT_DOMAIN_MODEL=gpt-5-mini
ECOSYSTEM_DOMAIN_MODEL=gpt-5-mini

INPUT_PROMPT_VERSION=input-v1
ECOSYSTEM_PROMPT_VERSION=ecosystem-mvp-v1

PORT=3000
APP_ENV=development
