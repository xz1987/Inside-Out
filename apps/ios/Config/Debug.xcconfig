// Shared, non-secret defaults. Local.xcconfig is gitignored so each developer
// can point a physical iPhone at their own Mac or HTTPS development tunnel.
API_BASE_URL = http:/$()/localhost:3000
INTERPRETATION_MODE = auto
INTERPRETATION_BASE_URL = https:/$()/api.ai.it.cornell.edu/v1
INTERPRETATION_MODEL = openai.gpt-5-mini
INTERPRETATION_API_KEY =
#include? "Local.xcconfig"
