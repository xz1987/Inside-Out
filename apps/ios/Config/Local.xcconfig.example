// Copy this file to Local.xcconfig (which is gitignored), then replace the
// hostname. In System Settings > General > Sharing, the Local hostname is the
// value ending in .local. Mac and iPhone must be able to reach each other.
//
// LAN example:
API_BASE_URL = http:/$()/your-mac-name.local:3000
//
// HTTPS tunnel/staging example (recommended on campus/guest Wi-Fi):
// API_BASE_URL = https:/$()/your-tunnel.example

// Physical-installation Direct Interpretation. Keep the real key only in the
// gitignored Local.xcconfig. With INTERPRETATION_MODE = auto, a configured key
// selects Direct mode; without one, the existing backend flow remains active.
INTERPRETATION_MODE = auto
INTERPRETATION_BASE_URL = https:/$()/api.ai.it.cornell.edu/v1
INTERPRETATION_MODEL = openai.gpt-5-mini
INTERPRETATION_API_KEY = paste-your-dedicated-revocable-demo-key-here
