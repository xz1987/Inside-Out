<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>API_BASE_URL</key>
	<string>$(API_BASE_URL)</string>
	<key>INTERPRETATION_MODE</key>
	<string>$(INTERPRETATION_MODE)</string>
	<key>INTERPRETATION_BASE_URL</key>
	<string>$(INTERPRETATION_BASE_URL)</string>
	<key>INTERPRETATION_MODEL</key>
	<string>$(INTERPRETATION_MODEL)</string>
	<key>INTERPRETATION_API_KEY</key>
	<string>$(INTERPRETATION_API_KEY)</string>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Inside Out</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
