	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Connect to the Inside Out installation and control its emotion pumps while the app is open.</string>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Connect to the Inside Out development server running on your Mac.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Record a daily event for your Figures.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Turn your spoken daily event into text on this iPhone.</string>
	<key>UILaunchScreen</key>
	<dict/>
