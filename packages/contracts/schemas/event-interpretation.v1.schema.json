{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://inside-out.local/schemas/event-interpretation.v1.schema.json",
  "title": "EventInterpretationV1",
  "description": "Domain A output: how one retrospective input is understood. Strict-mode compatible (all properties required, no extras).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "eventId", "summary", "turningPoint", "sourceType", "figures", "relationshipCues", "objectCandidate", "uncertainties"],
  "properties": {
    "schemaVersion": { "type": "string", "const": "event-interpretation.v1" },
    "eventId": { "type": "string", "minLength": 1 },
    "summary": { "type": "string", "minLength": 1, "maxLength": 200, "description": "1–2 sentence second-person summary, e.g. 'A driver cut you off on the way home.'" },
    "turningPoint": { "type": "string", "maxLength": 200 },
    "sourceType": { "type": "string", "enum": ["voice", "message", "replay"] },
    "figures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "description": "Fed Figures, most-fed first. Concentrations sum to 1 (±0.01).",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "concentration", "feed", "evidence", "voiceLine", "confidence"],
        "properties": {
          "id": { "$ref": "#/$defs/figureId" },
          "concentration": { "type": "number", "minimum": 0, "maximum": 1 },
          "feed": { "type": "integer", "minimum": 0, "maximum": 40 },
          "evidence": { "type": "string", "minLength": 1, "maxLength": 200 },
          "voiceLine": { "type": "string", "minLength": 1, "maxLength": 80, "description": "What the Figure says on the result screen, first person, in character." },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "relationshipCues": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["figures", "reason"],
        "properties": {
          "figures": { "type": "array", "items": { "$ref": "#/$defs/figureId" }, "minItems": 2, "maxItems": 2 },
          "reason": { "type": "string", "maxLength": 200 }
        }
      }
    },
    "objectCandidate": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["name", "source"],
      "properties": {
        "name": { "type": "string", "maxLength": 80 },
        "source": { "type": "string", "enum": ["literal", "symbolic"] }
      }
    },
    "uncertainties": { "type": "array", "items": { "type": "string", "maxLength": 200 }, "maxItems": 5 }
  },
  "$defs": {
    "figureId": { "type": "string", "enum": ["joy", "sadness", "anger", "fear"] }
  }
}
